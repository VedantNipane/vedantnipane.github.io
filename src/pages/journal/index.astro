---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Layout title="Journal — Vedant Nipane" description="Poems, articles, and thoughts by Vedant Nipane.">
  <div class="journal-page">

    <header class="journal-header">
      <a href="/" class="back-link">← Back</a>
      <h1>Journal</h1>
      <p class="journal-desc">
        Poems, essays, thoughts on life and the odd things I notice.
        No schedule, no format.
      </p>
    </header>

    <div class="filter-row" role="tablist" aria-label="Filter posts by type">
      <button class="filter-btn active" data-filter="all">All <span class="count">{allPosts.length}</span></button>
      <button class="filter-btn" data-filter="article">Articles <span class="count">{allPosts.filter(p => p.data.type === 'article').length}</span></button>
      <button class="filter-btn" data-filter="poem">Poems <span class="count">{allPosts.filter(p => p.data.type === 'poem').length}</span></button>
    </div>

    <ul class="post-list">
      {allPosts.map(post => (
        <li class="post-item" data-type={post.data.type}>
          <a href={`/journal/${post.id.replace(/\.md$/, '')}`} class="post-link">
            <div class="post-meta-row">
              <span class="post-type">{post.data.type}</span>
              <span class="post-date">{formatDate(post.data.date)}</span>
            </div>
            <p class="post-title">{post.data.title}</p>
            {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
            {post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>

  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.post-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter;
      items.forEach(item => {
        item.style.display =
          filter === 'all' || item.dataset.type === filter ? '' : 'none';
      });
    });
  });
</script>

<style>
  .journal-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  /* Header */
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--ink-soft);
    margin-bottom: 1.75rem;
  }
  .back-link:hover { color: var(--ink); }

  .journal-header h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 0.75rem;
  }

  .journal-desc {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 36em;
    margin: 0 0 2.5rem;
  }

  /* Filter */
  .filter-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1rem;
  }

  .filter-btn {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .filter-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .filter-btn .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.7;
    margin-left: 0.3rem;
  }

  /* Post list */
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item + .post-item {
    border-top: 1px solid var(--rule);
  }

  .post-link {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: none;
  }
  .post-link:hover .post-title {
    color: var(--accent-ink);
  }

  .post-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .post-type {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent-ink);
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    margin: 0 0 0.4rem;
    line-height: 1.2;
    transition: color 0.15s;
  }

  .post-excerpt {
    font-size: 0.97rem;
    color: var(--ink-soft);
    margin: 0 0 0.6rem;
    font-style: italic;
    max-width: 40em;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    padding: 0.15rem 0.5rem;
  }
</style>
