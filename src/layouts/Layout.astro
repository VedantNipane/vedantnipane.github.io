---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vedant Nipane',
  description = 'Data Scientist & Engineer — portfolio and journal.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y74Q8X13Z0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-Y74Q8X13Z0');
    </script>
  </head>
  <body>
    <nav class="top-nav">
      <div class="top-nav-inner">
        <a href="/" class="wordmark">
          <span class="wordmark-v">V</span><span class="wordmark-n">N</span>
          <span class="wordmark-dot"></span>
        </a>
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#publications">Publications</a></li>
          <li><a href="#resumes">Resume</a></li>
          <li><a href="/journal">Journal</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
    </nav>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-left">
          <span class="dither-frame footer-mark" aria-hidden="true">
            <span class="footer-mark-inner">VN</span>
          </span>
          <p class="footer-tag">Data &middot; Engineering &middot; Writing</p>
        </div>
        <p class="footer-meta">
          &copy; {new Date().getFullYear()} Vedant Nipane &middot;
          <a href="mailto:vedantlnipane0@gmail.com">vedantlnipane0@gmail.com</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        /* Warm paper palette */
        --bg: #f6f2e9;
        --bg-soft: #efe9db;
        --bg-invert: #141210;
        --ink: #141210;
        --ink-on-dark: #efe9db;
        --ink-soft: #6a6355;
        --rule: #d8d0bd;
        --rule-strong: #1a1715;
        --accent: #a44a2e;       /* muted terracotta */
        --accent-ink: #7a3620;
        --font-display: 'Space Grotesk', system-ui, -apple-system, sans-serif;
        --font-body: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
      }

      body {
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      ::selection { background: var(--ink); color: var(--bg); }

      a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--rule);
        transition: text-decoration-color 0.15s, color 0.15s;
      }
      a:hover {
        text-decoration-color: var(--accent);
        color: var(--accent-ink);
      }

      img { max-width: 100%; height: auto; display: block; }

      h1, h2, h3 {
        font-family: var(--font-display);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        margin: 0 0 0.5rem;
      }
      h1 { font-size: clamp(3rem, 8vw, 5.5rem); }
      h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 600; }
      h3 { font-size: 1.15rem; font-weight: 600; }

      p { margin: 0 0 1rem; }

      strong { font-weight: 600; color: var(--ink); }

      .eyebrow, .section-number, .meta {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--ink-soft);
      }

      /* ====== Top nav ====== */
      .top-nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(246, 242, 233, 0.92);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--rule);
      }
      .top-nav-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.95rem 1.75rem;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        letter-spacing: 0.01em;
      }
      .wordmark-v, .wordmark-n { display: inline-block; }
      .wordmark-dot {
        width: 7px; height: 7px;
        background: var(--accent);
        border-radius: 50%;
        display: inline-block;
      }
      .top-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 1.9rem;
      }
      .top-nav a {
        text-decoration: none;
        color: var(--ink-soft);
        font-size: 0.92rem;
        font-weight: 500;
      }
      .top-nav a:hover { color: var(--ink); text-decoration: none; }

      /* ====== Page container ====== */
      .site-main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3.5rem 1.75rem 5rem;
      }

      /* ====== Section block with margin label ====== */
      .block {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 2rem;
        align-items: start;
        padding: 4rem 0;
        border-top: 1px solid var(--rule);
      }
      .block-label {
        position: sticky;
        top: 5.5rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--ink-soft);
      }
      .block-label .num { display: block; color: var(--accent); margin-bottom: 0.3rem; }
      .block-body > :first-child { margin-top: 0; }

      /* Inverted block (Journal) */
      .block--invert {
        background: var(--bg-invert);
        color: var(--ink-on-dark);
        border-top-color: var(--bg-invert);
        padding: 4rem 2rem;
        margin: 3rem -2rem;
        border-radius: 2px;
      }
      .block--invert h2 { color: var(--ink-on-dark); }
      .block--invert .block-label { color: #b5ad9a; }
      .block--invert .block-label .num { color: var(--accent); }
      .block--invert a { color: var(--ink-on-dark); text-decoration-color: #554f42; }
      .block--invert a:hover { color: var(--accent); text-decoration-color: var(--accent); }

      /* ====== Dither accent utility ====== */
      .dither-frame {
        display: inline-block;
        padding: 8px;
        background-color: var(--bg);
        background-image:
          linear-gradient(45deg, var(--ink) 25%, transparent 25%, transparent 75%, var(--ink) 75%),
          linear-gradient(45deg, var(--ink) 25%, transparent 25%, transparent 75%, var(--ink) 75%);
        background-size: 4px 4px;
        background-position: 0 0, 2px 2px;
      }
      .dither-frame img, .dither-frame .footer-mark-inner { display: block; }

      /* ====== Footer ====== */
      .site-footer {
        border-top: 1px solid var(--rule);
        margin-top: 2rem;
      }
      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.75rem 3rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
      }
      .footer-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .footer-mark-inner {
        width: 38px;
        height: 38px;
        background: var(--bg);
        border: 2px solid var(--ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: 0.04em;
      }
      .footer-tag {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin: 0;
      }
      .footer-meta {
        font-size: 0.9rem;
        color: var(--ink-soft);
        margin: 0;
      }

      /* ====== Mobile ====== */
      @media (max-width: 820px) {
        .block {
          grid-template-columns: 1fr;
          gap: 0.75rem;
          padding: 3rem 0;
        }
        .block-label {
          position: static;
        }
        .block--invert { margin: 2rem -1.25rem; padding: 3rem 1.5rem; }
      }

      @media (max-width: 640px) {
        .top-nav-inner { padding: 0.7rem 1.25rem; }
        .top-nav ul { gap: 1rem; }
        .top-nav a { font-size: 0.82rem; }
        .site-main { padding: 2rem 1.25rem 3rem; }
        .footer-inner { padding: 2rem 1.25rem; }
      }
    </style>
  </body>
</html>
